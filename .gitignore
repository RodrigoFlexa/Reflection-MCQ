# Segredos: o .env guarda credenciais (HF_TOKEN, AZURE_OPENAI_API_KEY...).
# Nunca versionar.
.env
.env.*
!.env.example
*.pem

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
.venv-validation/
venv/
env/

# VS Code
.vscode/

# System files
Thumbs.db
.DS_Store

# Pesos e cache de modelos: grandes e reproduzíveis via `ollama pull` / Hub.
models/*

# Cache em disco das respostas de backends de API (Azure, Ollama).
cache/*

backups/*
backup/*
data/*
logs/threshold08.log
config-v1.x.ini
config-v1.x.ini:Zone.Identifier
config.ini
logs/
.tmp_test_exchange/
.tmp_test_results/
.run_state/

# Arquivo morto: o que saiu de circulação continua no disco, fora do Git.
_archive/

# results_definitivos: o README, o manifest, a cobertura e as lacunas são
# versionados — são eles que tornam o resultado auditável e cabem num diff.
# O all_outcomes.jsonl tem centenas de MB e é reconstruível por
# `python consolidate_results.py build`, então fica de fora.
results_definitivos/*/all_outcomes.jsonl
results_definitivos/*/all_outcomes.jsonl.tmp
results_definitivos/*/analysis/

# Pacotes de resultados gerados para compartilhar.
*.zip

# Artefatos de geração dos runs: pares, tentativas de treino e reflexões somam
# gigabytes e são reproduzíveis. O que fica versionado de cada run é o metadado
# que explica o que ele foi — manifest, recibos e auditoria da recuperação —,
# porque é isso que a consolidação lê e o que torna um número rastreável.
# A troca entre servidores usa os pacotes de experiment_handoff/, não estes.
experiment_exchange/*/students/
experiment_exchange/*/pairs/
experiment_exchange/*/teacher/
