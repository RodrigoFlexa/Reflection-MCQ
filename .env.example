# Copie para .env e ajuste. O .env é lido por rmcq/__init__.py, ANTES de
# qualquer import de torch, que é a única janela em que CUDA_VISIBLE_DEVICES
# ainda tem efeito.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------
# Qual GPU usar. Índices separados por vírgula, contados a partir de 0.
#   CUDA_VISIBLE_DEVICES=0      -> só a primeira GPU
#   CUDA_VISIBLE_DEVICES=2      -> só a terceira
#   CUDA_VISIBLE_DEVICES=0,1    -> duas GPUs (vLLM usa como tensor parallel)
#   CUDA_VISIBLE_DEVICES=""     -> força CPU
CUDA_VISIBLE_DEVICES=4

# ---------------------------------------------------------------------------
# HuggingFace
# ---------------------------------------------------------------------------
# Obrigatório: o Meta-Llama-3-8B-Instruct é gated com aprovação manual.
# Aceite os termos em huggingface.co/meta-llama/Meta-Llama-3-8B-Instruct.
HF_TOKEN=

# Onde os pesos ficam. Padrão: ./models/hf_cache
# HF_HOME=/caminho/para/cache

# Acelera o download de arquivos grandes. O hf_transfer foi aposentado; quem
# faz esse trabalho agora é o hf-xet, que já vem com o huggingface_hub 1.x.
HF_XET_HIGH_PERFORMANCE=1

# ---------------------------------------------------------------------------
# Backend de geração
# ---------------------------------------------------------------------------
# vllm  -> continuous batching, ~10x mais rápido, use para rodar a grade
# hf    -> transformers, mesmo caminho dos notebooks, use para debug
# stub  -> backend falso e determinístico, sem GPU, para testar o pipeline
RMCQ_BACKEND=vllm

# Fração da VRAM que o vLLM reserva. Baixe se dividir a GPU com outra coisa.
RMCQ_VLLM_GPU_UTIL=0.90

# Modo deterministico do vLLM (padrao: 1 = ligado).
# Com temperatura 0 a decodificacao e greedy, mas o continuous batching faz a
# aritmetica depender da composicao do lote e o argmax vira em empates quase
# exatos. Medido neste projeto: itens com prompt byte a byte identico ao do
# baseline so reproduziram a mesma letra em 94,44% das vezes -- ~5,6% de ruido,
# que com n=300 da um desvio-padrao de utility de +/-0,0136, do tamanho dos
# efeitos que a grade quer medir.
# Desligue (=0) so quando throughput importar mais que reprodutibilidade.
RMCQ_VLLM_DETERMINISTIC=1
# Lote fixo: uma fonte a menos de variacao. Menor = mais lento e mais estavel.
RMCQ_VLLM_MAX_NUM_SEQS=32

# Tamanho de lote do backend hf. Ignorado pelo vLLM, que gerencia sozinho.
RMCQ_HF_BATCH_SIZE=16

# Limite de contexto. Deixar vazio faz cada modelo usar o padrão dele, e os
# padrões NÃO são comparáveis: no vLLM o Phi-4-mini deriva 4096 (o
# original_max_position_embeddings do longrope), o Llama-3 8192 e o Qwen3 40960.
# Como o prompt é truncado à esquerda para caber, contextos diferentes fariam
# cada modelo enxergar um número diferente de reflexões recuperadas na mesma
# condição. Fixar aqui iguala. O que sobra para o prompt é este valor menos
# RMCQ_MAX_NEW_TOKENS, e os backends levantam ValueError se isso não for > 0.
RMCQ_MAX_MODEL_LEN=8192

# ---------------------------------------------------------------------------
# Recuperação por similaridade
# ---------------------------------------------------------------------------
RMCQ_EMBEDDER=BAAI/bge-large-en-v1.5
RMCQ_EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Escopo da rodada
# ---------------------------------------------------------------------------
# Quais modelos participam, nos DOIS papéis (aluno e professor). O registro em
# rmcq/config.py tem quatro; esta variável escolhe o subconjunto ativo.
#   RMCQ_ACTIVE_MODELS=phi4-mini,llama3-8b   -> 4 pares, 2 auto + 2 externos
#   RMCQ_ACTIVE_MODELS=all                   -> os quatro, 16 pares
RMCQ_ACTIVE_MODELS=phi4-mini,llama3-8b

# Quantas reflexões recuperadas entram no prompt na etapa de avaliação.
# Candidatos registrados no Caderno: 1, 3, 5.
#   RMCQ_K_VALUES=3       -> um valor só
#   RMCQ_K_VALUES=1,3,5   -> a grade completa de k
RMCQ_K_VALUES=3

# ---------------------------------------------------------------------------
# Execução
# ---------------------------------------------------------------------------
# Semente global. O Caderno fixa 42.
RMCQ_SEED=42

# Teto de tokens gerados. O Caderno fixa 4096; baixar acelera muito e é útil
# para pilotos, mas trunca cadeias de raciocínio longas.
RMCQ_MAX_NEW_TOKENS=4096

# Número de amostras da condição self-consistency.
RMCQ_SELFCONS_N=5

# Nível de log: DEBUG, INFO, WARNING
RMCQ_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Azure OpenAI — professores de API
# ---------------------------------------------------------------------------
# Só faz sentido preencher na máquina que tem acesso ao Azure (ambiente
# Petrobras). Na máquina local os deployments existem apenas para que `eval` e
# `analyze` saibam ler as reflexões que voltaram por git — sem credencial.
#
# NUNCA commite o .env preenchido. O .gitignore já o exclui; confira com
# `git status` antes de qualquer push.

# --- para onde ir. Use UMA das duas; são mutuamente exclusivas no SDK. -------
#
# BASE_URL: a URL é usada COMO ESTÁ. É o que gateway corporativo exige, e o que
# aparece nos exemplos oficiais da Petrobras (AZURE_OPENAI_BASE_URL no
# config-v1.x.ini). Se você tem esse arquivo, copie o valor de lá.
AZURE_OPENAI_BASE_URL=

# ENDPOINT: alternativa para recurso Azure padrão. O SDK monta
# /openai/deployments/<modelo>/... em cima dela. Deixe VAZIO se usar BASE_URL.
AZURE_OPENAI_ENDPOINT=

AZURE_OPENAI_API_KEY=

# Copie do seu config-v1.x.ini (OPENAI_API_VERSION) se existir: o gateway pode
# exigir uma versão específica. Atenção: 2024-10-21 é anterior ao gpt-5.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Certificado raiz da CA corporativa, em PEM (o petrobras-ca-root.pem dos
# exemplos). Sem ele, a inspeção TLS do proxy derruba a conexão com erro de
# certificado desconhecido. Caminho relativo é resolvido a partir da raiz do
# repositório. Deixe vazio se a rede não fizer inspeção TLS.
AZURE_OPENAI_CA_BUNDLE=

# --- quais deployments existem ----------------------------------------------
# O nome do DEPLOYMENT vira a chave do modelo, e é ele que nomeia os
# diretórios de saída (results/reflections/{aluno}__{deployment}__{depth}/).
# Não há apelido genérico de propósito: um "gpt5" apontando para
# "gpt-5-mini-petrobras" produziria resultados rotulados como se fossem do
# GPT-5 completo, sem registro de qual modelo de fato escreveu.
RMCQ_AZURE_DEPLOYMENTS=gpt-5-mini-petrobras

# Depois de declarar, use o nome inteiro nos comandos e nas variáveis:
#   RMCQ_ACTIVE_MODELS=phi4-mini,llama3-8b,qwen3-8b,mistral-7b,gpt-5-mini-petrobras
#   RMCQ_TEACHERS=gpt-5-mini-petrobras

# Chamadas simultâneas. A etapa reflect manda lotes de até ~380 prompts;
# sequencial levaria horas por lote. Suba com cuidado: 429 é o limite prático.
RMCQ_AZURE_CONCURRENCY=4

# Teto de tokens de resposta. Separado de RMCQ_MAX_NEW_TOKENS porque na GPU
# local 4096 é grátis e aqui é dinheiro.
RMCQ_AZURE_MAX_TOKENS=1024

# Piso de orçamento para modelos de reasoning (gpt-5, o1, o3, o4-mini). Eles
# gastam tokens PENSANDO antes de escrever: com orçamento curto a API devolve
# content="" e finish_reason="length". Se isso acontecer, suba para 6000-8000.
RMCQ_AZURE_REASONING_MIN_TOKENS=4000

# minimal | low | medium | high  (vazio omite o parâmetro)
RMCQ_AZURE_REASONING_EFFORT=low

# Resposta vazia é falha de configuração, nunca abstenção do modelo: a primeira
# aborta a execução com o diagnóstico. Só desligue para depurar.
RMCQ_AZURE_FAIL_ON_EMPTY=1

# Cache em disco por chamada (results/cache/azure/). Torna rerun após queda
# gratuito — importante porque reflect só grava o JSONL ao fim de cada lote.
RMCQ_AZURE_CACHE=1
