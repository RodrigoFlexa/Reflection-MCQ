# Copie para .env e ajuste. O .env é lido por rmcq/__init__.py, ANTES de
# qualquer import de torch, que é a única janela em que CUDA_VISIBLE_DEVICES
# ainda tem efeito.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------
# Qual GPU usar. Índices separados por vírgula, contados a partir de 0.
#   CUDA_VISIBLE_DEVICES=0      -> só a primeira GPU
#   CUDA_VISIBLE_DEVICES=2      -> só a terceira
#   CUDA_VISIBLE_DEVICES=0,1    -> duas GPUs (vLLM usa como tensor parallel)
#   CUDA_VISIBLE_DEVICES=""     -> força CPU
CUDA_VISIBLE_DEVICES=0

# ---------------------------------------------------------------------------
# HuggingFace
# ---------------------------------------------------------------------------
# Obrigatório: o Meta-Llama-3-8B-Instruct é gated com aprovação manual.
# Aceite os termos em huggingface.co/meta-llama/Meta-Llama-3-8B-Instruct.
HF_TOKEN=

# Onde os pesos ficam. Padrão: ./models/hf_cache
# HF_HOME=/caminho/para/cache

# Acelera o download de arquivos grandes (precisa de `pip install hf_transfer`).
HF_HUB_ENABLE_HF_TRANSFER=1

# ---------------------------------------------------------------------------
# Backend de geração
# ---------------------------------------------------------------------------
# vllm  -> continuous batching, ~10x mais rápido, use para rodar a grade
# hf    -> transformers, mesmo caminho dos notebooks, use para debug
# stub  -> backend falso e determinístico, sem GPU, para testar o pipeline
RMCQ_BACKEND=vllm

# Fração da VRAM que o vLLM reserva. Baixe se dividir a GPU com outra coisa.
RMCQ_VLLM_GPU_UTIL=0.90

# Tamanho de lote do backend hf. Ignorado pelo vLLM, que gerencia sozinho.
RMCQ_HF_BATCH_SIZE=16

# Limite de contexto. None deixa cada modelo usar o padrão dele.
# RMCQ_MAX_MODEL_LEN=8192

# ---------------------------------------------------------------------------
# Recuperação por similaridade
# ---------------------------------------------------------------------------
RMCQ_EMBEDDER=BAAI/bge-large-en-v1.5
RMCQ_EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Escopo da rodada
# ---------------------------------------------------------------------------
# Quais modelos participam, nos DOIS papéis (aluno e professor). O registro em
# rmcq/config.py tem quatro; esta variável escolhe o subconjunto ativo.
#   RMCQ_ACTIVE_MODELS=phi4-mini,llama3-8b   -> 4 pares, 2 auto + 2 externos
#   RMCQ_ACTIVE_MODELS=all                   -> os quatro, 16 pares
RMCQ_ACTIVE_MODELS=phi4-mini,llama3-8b

# Quantas reflexões recuperadas entram no prompt na etapa de avaliação.
# Candidatos registrados no Caderno: 1, 3, 5.
#   RMCQ_K_VALUES=3       -> um valor só
#   RMCQ_K_VALUES=1,3,5   -> a grade completa de k
RMCQ_K_VALUES=3

# ---------------------------------------------------------------------------
# Execução
# ---------------------------------------------------------------------------
# Semente global. O Caderno fixa 42.
RMCQ_SEED=42

# Teto de tokens gerados. O Caderno fixa 4096; baixar acelera muito e é útil
# para pilotos, mas trunca cadeias de raciocínio longas.
RMCQ_MAX_NEW_TOKENS=4096

# Número de amostras da condição self-consistency.
RMCQ_SELFCONS_N=5

# Nível de log: DEBUG, INFO, WARNING
RMCQ_LOG_LEVEL=INFO
