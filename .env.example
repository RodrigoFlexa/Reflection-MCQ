# Copie para .env e ajuste. O .env é lido por rmcq/__init__.py, ANTES de
# qualquer import de torch, que é a única janela em que CUDA_VISIBLE_DEVICES
# ainda tem efeito.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# GPU (backends hf / vLLM)
# ---------------------------------------------------------------------------
# Qual GPU usar. Índices separados por vírgula, contados a partir de 0.
#   CUDA_VISIBLE_DEVICES=0      -> só a primeira GPU
#   CUDA_VISIBLE_DEVICES=0,1    -> duas GPUs (vLLM usa como tensor parallel)
#   CUDA_VISIBLE_DEVICES=""     -> força CPU
CUDA_VISIBLE_DEVICES=0

# ---------------------------------------------------------------------------
# HuggingFace (backends hf / vLLM)
# ---------------------------------------------------------------------------
# Obrigatório para modelos gated (ex.: Meta-Llama-3-8B-Instruct): aceite os
# termos na página do modelo no Hub antes de preencher.
HF_TOKEN=

# Onde os pesos ficam. Padrão: ./models/hf_cache
# HF_HOME=/caminho/para/cache

# ---------------------------------------------------------------------------
# Backend de geração local
# ---------------------------------------------------------------------------
# vllm  -> continuous batching, muito mais rápido, use para servir a grade
# hf    -> transformers, mais fácil de depurar item a item
# stub  -> backend falso e determinístico, sem GPU, para testar a integração
RMCQ_BACKEND=vllm

RMCQ_VLLM_GPU_UTIL=0.90
RMCQ_VLLM_DETERMINISTIC=1
RMCQ_VLLM_MAX_NUM_SEQS=32
RMCQ_HF_BATCH_SIZE=16

# Limite de contexto. Vazio usa o padrão de cada modelo.
# RMCQ_MAX_MODEL_LEN=8192

RMCQ_SEED=42
RMCQ_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
# NUNCA commite o .env preenchido. O .gitignore já o exclui; confira com
# `git status` antes de qualquer push.

# --- para onde ir. Use UMA das duas; são mutuamente exclusivas no SDK. -------
# BASE_URL: a URL é usada COMO ESTÁ. É o que gateway corporativo costuma exigir.
AZURE_OPENAI_BASE_URL=
# ENDPOINT: alternativa para recurso Azure padrão; o SDK monta
# /openai/deployments/<modelo>/... em cima dela. Deixe VAZIO se usar BASE_URL.
AZURE_OPENAI_ENDPOINT=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Certificado raiz de CA corporativa, em PEM. Deixe vazio se a rede não fizer
# inspeção TLS. Caminho relativo é resolvido a partir da raiz do repositório.
AZURE_OPENAI_CA_BUNDLE=

# Nomes de deployment: cada um vira uma chave de modelo em rmcq.config.MODELS,
# com esse mesmo nome — não há apelido genérico escondendo qual deployment
# respondeu de fato.
# Exemplo do experimento 08: gpt-5-4-petrobras
RMCQ_AZURE_DEPLOYMENTS=

RMCQ_AZURE_CONCURRENCY=4
RMCQ_AZURE_MAX_TOKENS=1024
# Modelos de reasoning (gpt-5, o1, o3, o4-mini) gastam tokens PENSANDO antes
# de escrever; orçamento curto devolve content="" e finish_reason="length".
RMCQ_AZURE_REASONING_MIN_TOKENS=4000
RMCQ_AZURE_REASONING_EFFORT=low
RMCQ_AZURE_FAIL_ON_EMPTY=1
# Continua a grade quando apenas um prompt é bloqueado pela política de conteúdo.
# O item fica como não resolvido e é contabilizado nos recibos/auditoria.
RMCQ_AZURE_CONTINUE_ON_CONTENT_FILTER=1
RMCQ_AZURE_CACHE=1

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
# Requer um `ollama serve` acessível (local ou remoto) e o modelo já baixado
# com `ollama pull <tag>`.
RMCQ_OLLAMA_BASE_URL=http://localhost:11434

# Tags de modelo, exatamente como aparecem em `ollama list`. Cada uma vira uma
# chave de modelo em rmcq.config.MODELS.
#   RMCQ_OLLAMA_MODELS=outro-modelo:tag
RMCQ_OLLAMA_MODELS=

RMCQ_OLLAMA_TIMEOUT=1800
RMCQ_OLLAMA_KEEP_ALIVE=30m
RMCQ_OLLAMA_THINK=0
# Recomendado para DeepSeek-R1 Distill: comporta raciocínio longo sem reservar 128k.
RMCQ_OLLAMA_NUM_CTX=16384
